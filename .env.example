# Copy to `.env` (repo root) or `backend/.env`. Never commit the real file.

# --- Runtime -------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------
# Default: SQLite file at backend/nvl.db. Production: PostgreSQL (postgres:// URLs are accepted).
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/nvl
VECTOR_BACKEND=memory              # memory | pgvector

# --- AI analysis (server-side only; never put keys in the frontend) -------
LLM_PROVIDER=anthropic             # anthropic | baseline
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium                  # low | medium | high | xhigh | max
LLM_MAX_TOKENS=16000

# --- Semantic search embeddings -------------------------------------------
EMBEDDING_PROVIDER=hashing         # hashing | sentence-transformers (pip install -e "backend[embeddings]")
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- OCR ---------------------------------------------------------------------
OCR_PROVIDER=anthropic             # anthropic | tesseract | none
OCR_MAX_UPLOAD_MB=8
# TESSERACT_CMD=tesseract
# TESSERACT_LANG=nep

# --- Public API protection ------------------------------------------------
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_ANALYZE_PER_HOUR=30     # applies to AI analyses only
RATE_LIMIT_OCR_PER_HOUR=20
MAX_PHRASE_CHARS=600
TRUST_PROXY_HEADERS=false          # true behind Render/Fly/Railway proxies

# --- Researcher area -------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=               # python scripts/hash_password.py  (empty disables the area)
JWT_SECRET=                        # long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_TTL_HOURS=12
